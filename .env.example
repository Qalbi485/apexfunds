# Copy to .env and fill in values before deploying

# SQLite for local; on production server use the real path or switch to PostgreSQL
DATABASE_URL="file:./dev.db"

# Random 64-char hex string (sessions) — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Broker: "mock" for demo, "custom" when live broker API ready
BROKER_DRIVER=mock
BROKER_API_URL=
BROKER_API_KEY=

# TwelveData API key (free tier) — supplies REAL forex candles to the chart.
# Live price comes from the Swissquote feed (no key needed).
# Free key: https://twelvedata.com/register
TWELVEDATA_API_KEY=

SITE_URL=https://yourdomain.com
USDT_TRC20_ADDRESS=
USDT_ERC20_ADDRESS=

# Email (SMTP) — optional, alerts activate when filled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Telegram admin alerts — optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cron auto-sync secret (GET /api/cron/sync with header Authorization: Bearer <this>)
CRON_SECRET=

# Logging: debug | info | warn | error (structured JSON to stdout/stderr)
LOG_LEVEL=info

# Rate limits (optional overrides; defaults are production-sensible)
# All limiters are database-backed (shared across app instances).
# RL_LOGIN_IP_LIMIT=20
# RL_LOGIN_IP_WINDOW_MS=300000
# RL_LOGIN_EMAIL_LIMIT=8
# RL_LOGIN_EMAIL_WINDOW_MS=900000
# RL_REGISTER_IP_LIMIT=10
# RL_RESET_IP_LIMIT=10
# RL_RESET_EMAIL_LIMIT=5
# RL_TRADE_OPEN_LIMIT=30
# RL_TRADE_SETTLE_LIMIT=60
